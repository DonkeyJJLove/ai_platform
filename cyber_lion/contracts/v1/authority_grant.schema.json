{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cyberlion://schemas/authority-grant/v1",
  "title": "Cyber-Lion Authority Grant v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "grant_id",
    "issuer_subject_id",
    "subject_id",
    "tenant_id",
    "organization_id",
    "mission_id",
    "capability_id",
    "capability_version",
    "actions",
    "resource_scope",
    "authority_ceiling",
    "constraints",
    "parent_grant_id",
    "issued_at",
    "expires_at",
    "epoch",
    "policy_digest",
    "observability_contract_digest",
    "signature"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "grant_id": {"type": "string", "minLength": 1},
    "issuer_subject_id": {"type": "string", "minLength": 1},
    "subject_id": {"type": "string", "minLength": 1},
    "tenant_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "mission_id": {"type": "string", "minLength": 1},
    "capability_id": {"type": "string", "minLength": 1},
    "capability_version": {"type": "string", "minLength": 1},
    "actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "resource_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "authority_ceiling": {
      "enum": ["none", "read", "local_write", "external_write", "financial", "deploy", "privileged"]
    },
    "constraints": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "parent_grant_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "minLength": 1}
      ]
    },
    "issued_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "epoch": {"type": "integer", "minimum": 0},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "observability_contract_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signature": {"type": "string", "minLength": 1}
  }
}
