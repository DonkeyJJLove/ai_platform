{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"lion.swarm_status.schema.json","title":"LION deterministic operational status","type":"object","additionalProperties":true,"required":["schema_version","system_id","revision","status_digest","previous_status_digest","revision_digest","previous_revision_digest","observed_master","governor","architecture","critical_path","formations","missions","drones","role_assignments","dependencies","blockers","channels","pending_messages","current_actions","history","epistemic_state","source_refs","generated_at"],"properties":{"schema_version":{"const":"1.0.0"},"system_id":{"const":"LION"},"revision":{"type":"integer","minimum":0},"status_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"previous_status_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"revision_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"previous_revision_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"observed_master":{"type":"object","required":["commit","tree","observed_at"]},"governor":{"type":"object","required":["logical_role","instance_id","state","epoch","fencing_token","is_authority_source"]},"formations":{"type":"array"},"missions":{"type":"array"},"drones":{"type":"array"},"role_assignments":{"type":"array"},"dependencies":{"type":"array"},"blockers":{"type":"array"},"channels":{"type":"array"},"pending_messages":{"type":"array"},"current_actions":{"type":"array"},"history":{"type":"array"},"epistemic_state":{"enum":["CURRENT","STALE","UNKNOWN","CONFLICTED"]},"source_refs":{"type":"array","items":{"type":"string"}},"generated_at":{"type":"string","format":"date-time"}}}