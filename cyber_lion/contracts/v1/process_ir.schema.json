{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cyberlion://schemas/process-ir/v1",
  "title": "LION Canonical Process IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","process_id","mission_ref","goal_ref","scope","initial_state","states","dependencies","transitions","scheduling_policy","termination_policy","lineage"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "process_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]{0,255}$"},
    "mission_ref": {"type": "string", "minLength": 1},
    "goal_ref": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["domains","resources","widening_allowed"],
      "properties": {
        "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "resources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "widening_allowed": {"const": false}
      }
    },
    "initial_state": {"type": "string", "minLength": 1},
    "states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]{0,255}$"}},
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["dependency_id","required","description"],
        "properties": {
          "dependency_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]{0,255}$"},
          "required": {"type": "boolean"},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "transitions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["transition_id","transition_class","source_states","trigger","dependencies","guards","evidence_requirements","currentness_requirements","authority_requirements","operator","expected_postconditions","outcome_map","retry_policy","replay_policy","idempotency_class","resource_claims"],
        "properties": {
          "transition_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:/-]{0,255}$"},
          "transition_class": {"enum": ["INTERNAL","ACTION_REQUIRED"]},
          "source_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "trigger": {"type": "string", "minLength": 1},
          "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "guards": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "evidence_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "currentness_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "authority_requirements": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "operator": {"enum": ["ASSERT","CONTINUE","DEFER","DEGRADE","DERIVE","EMIT_ACTION_INTENT","FALSIFY","HANDOFF","OBSERVE","PREPARE","PROHIBIT","READBACK","REACQUIRE","RECONCILE","REQUEST_AUTHORITY_CONTEXT","REQUIRE","STOP","SUPERSEDE","VERIFY","VERIFY_AUTHORITY_CONTEXT"]},
          "expected_postconditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "outcome_map": {
            "type": "object", "minProperties": 1, "additionalProperties": false,
            "properties": {
              "PASS": {"type": "string", "minLength": 1}, "FAIL": {"type": "string", "minLength": 1},
              "UNKNOWN": {"type": "string", "minLength": 1}, "DRIFT": {"type": "string", "minLength": 1},
              "BLOCKED": {"type": "string", "minLength": 1}, "AUTHORITY_BOUNDARY": {"type": "string", "minLength": 1},
              "COMPLETE": {"type": "string", "minLength": 1}
            }
          },
          "retry_policy": {
            "type": "object", "additionalProperties": false, "required": ["max_attempts","on_exhausted"],
            "properties": {"max_attempts": {"type": "integer", "minimum": 0, "maximum": 100}, "on_exhausted": {"enum": ["BLOCKED","HANDOFF","STOP","UNKNOWN"]}}
          },
          "replay_policy": {"enum": ["DENY","IDEMPOTENT","RECONCILE_FIRST"]},
          "idempotency_class": {"enum": ["PURE","IDEMPOTENT","NON_IDEMPOTENT"]},
          "resource_claims": {
            "type": "object", "additionalProperties": false,
            "required": ["read_scopes","write_scopes","authority_budgets","currentness_subjects","replay_domain","reconciliation_group"],
            "properties": {
              "read_scopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "write_scopes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "authority_budgets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "currentness_subjects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "replay_domain": {"type": "string"}, "reconciliation_group": {"type": "string"}
            }
          }
        },
        "allOf": [{
          "if": {"properties": {"transition_class": {"const": "ACTION_REQUIRED"}}, "required": ["transition_class"]},
          "then": {"properties": {"operator": {"const": "EMIT_ACTION_INTENT"}, "evidence_requirements": {"minItems": 1}, "currentness_requirements": {"minItems": 1}, "authority_requirements": {"minItems": 1}}}
        }]
      }
    },
    "scheduling_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy","order","priorities","max_wip","parallel_safe_groups"],
      "properties": {
        "strategy": {"enum": ["DECLARED_ORDER","EXPLICIT_PRIORITY"]},
        "order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "priorities": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "max_wip": {"type": "integer", "minimum": 1, "maximum": 128},
        "parallel_safe_groups": {"type": "array", "items": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
      }
    },
    "termination_policy": {
      "type": "object", "additionalProperties": false, "required": ["terminal_states","allow_no_legal_transition","on_unknown"],
      "properties": {"terminal_states": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "allow_no_legal_transition": {"type": "boolean"}, "on_unknown": {"enum": ["HANDOFF","STOP","DEFER"]}}
    },
    "lineage": {
      "type": "object", "additionalProperties": false, "required": ["parent_process_digests","generation","source_refs"],
      "properties": {"parent_process_digests": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}, "generation": {"type": "integer", "minimum": 0}, "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    }
  }
}
