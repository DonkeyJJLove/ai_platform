{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cyberlion://schemas/repository-manifest/v1",
  "title": "Cyber-Lion Repository Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "cyber_lion",
    "capabilities",
    "authority",
    "observability",
    "security",
    "epistemic"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "repository": {
      "type": "object",
      "required": [
        "id",
        "url",
        "owner",
        "default_branch"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "default_branch": {
          "type": "string"
        },
        "vcs_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "cyber_lion": {
      "type": "object",
      "required": [
        "tile_id",
        "roles",
        "layers",
        "disposition"
      ],
      "properties": {
        "tile_id": {
          "type": "string"
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "layers": {
          "type": "array",
          "items": {
            "enum": [
              "INF",
              "SEM",
              "MAND"
            ]
          }
        },
        "disposition": {
          "type": "array",
          "items": {
            "enum": [
              "KEEP",
              "REFINE",
              "EXTRACT",
              "GENERALIZE",
              "INTEGRATE",
              "DEPRECATE",
              "EXPERIMENTAL",
              "UNKNOWN"
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "maximum_level",
        "required_gates"
      ],
      "properties": {
        "maximum_level": {
          "type": "string"
        },
        "required_gates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "observability": {
      "type": "object",
      "required": [
        "logs",
        "metrics",
        "traces"
      ],
      "properties": {
        "logs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "traces": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "security": {
      "type": "object",
      "required": [
        "trust_boundaries"
      ],
      "properties": {
        "trust_boundaries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "epistemic": {
      "type": "object",
      "required": [
        "status",
        "confidence"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      },
      "additionalProperties": false
    },
    "architecture_knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "global_owner",
        "semantic_exports",
        "semantic_imports",
        "repository_dependencies",
        "architecture_artifacts",
        "discoverability",
        "invalidation_triggers"
      ],
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "global_owner": {
          "const": "DonkeyJJLove/ai_platform"
        },
        "semantic_exports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "semantic_imports": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "repository_dependencies": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
          },
          "uniqueItems": true
        },
        "architecture_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "class",
              "currentness"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "class": {
                "enum": [
                  "HUMAN_ARCHITECTURE_DOCUMENT",
                  "MACHINE_READABLE_ARCHITECTURE",
                  "CONTRACT",
                  "SCHEMA",
                  "ROADMAP",
                  "PROCESS_GUARD",
                  "RESEARCH_ARCHITECTURE",
                  "GENERATED_PROJECTION"
                ]
              },
              "currentness": {
                "enum": [
                  "SOURCE_BOUND",
                  "VERSIONED_STATIC",
                  "HISTORICAL",
                  "GENERATED",
                  "LOCAL_OWNER"
                ]
              }
            }
          }
        },
        "discoverability": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "entrypoint",
            "global_owner_route",
            "max_reads_to_global_owner"
          ],
          "properties": {
            "entrypoint": {
              "type": "string",
              "minLength": 1
            },
            "global_owner_route": {
              "type": "string",
              "minLength": 1
            },
            "max_reads_to_global_owner": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            }
          }
        },
        "invalidation_triggers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "SOURCE_CHANGE",
              "CONTRACT_CHANGE",
              "CAPABILITY_CHANGE",
              "SEMANTIC_OWNER_CHANGE",
              "FLOW_CHANGE",
              "RUNTIME_OBSERVATION",
              "CURRENTNESS_CHANGE",
              "RAG_RELEASE",
              "REPOSITORY_ROLE_CHANGE",
              "DEPENDENCY_CHANGE"
            ]
          }
        }
      }
    }
  }
}
