{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"cyberlion://schemas/gate-applied/v1","type":"object","additionalProperties":false,"required":["schema_version","gate_event_id","request_id","proposal_id","decision","effective_authority","policy_binding","authority_lineage_digest","enterprise_graph_digest","status_digest","observability_state","lane","rationale","decision_digest"],"properties":{"schema_version":{"const":"1.0.0"},"gate_event_id":{"type":"string","minLength":1},"request_id":{"type":"string","minLength":1},"proposal_id":{"type":"string","minLength":1},"decision":{"enum":["ALLOW","DENY"]},"effective_authority":{"type":"string","minLength":1},"policy_binding":{"type":"string","minLength":1},"authority_lineage_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"enterprise_graph_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"status_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"observability_state":{"enum":["HEALTHY","DEGRADED","LOST"]},"lane":{"enum":["GREEN","AMBER","RED"]},"rationale":{"type":"string","minLength":1},"decision_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}},"allOf":[{"if":{"properties":{"decision":{"const":"DENY"}}},"then":{"properties":{"effective_authority":{"const":"none"}}}}]}