{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"cyberlion://schemas/agent-instance/v1","title":"Cyber-Lion AgentInstance v1","type":"object","additionalProperties":false,"required":["schema_version","instance_id","agent_id","spec_version","spec_digest","state","generation","created_at","updated_at","evidence_refs"],"properties":{"schema_version":{"const":"1.0.0"},"instance_id":{"type":"string","minLength":1},"agent_id":{"type":"string","minLength":1},"spec_version":{"type":"string","minLength":1},"spec_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"state":{"enum":["REGISTERED","ACTIVE","SUSPENDED","REVOKED","TERMINATED"]},"generation":{"type":"integer","minimum":0},"created_at":{"type":"string","minLength":1},"updated_at":{"type":"string","minLength":1},"evidence_refs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}}