[Unit]
Description=LION generic read-only Mission Control
After=network-online.target lion-vkt-effect-admission.socket
Wants=network-online.target
[Service]
Type=simple
User=sentinelx
Group=sentinelx
RuntimeDirectory=lion-mission-control
RuntimeDirectoryMode=0755
WorkingDirectory=/opt/lion/k3s-vkt-r3/repo
Environment=PYTHONPATH=/opt/lion/k3s-vkt-r3/repo
ExecStart=/usr/bin/python3 /opt/lion/k3s-vkt-r3/repo/tools/lion_mission_control.py --source-identity /opt/lion/k3s-vkt-r3/source-identity.json --db /var/lib/sentinelx/uploads/lion-mission-control/mission-control.db serve
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadOnlyPaths=/opt/lion/k3s-vkt-r3
ReadWritePaths=/var/lib/sentinelx/uploads/lion-mission-control /run/lion-mission-control /run/lion-vkt-mission-control
UMask=0077
[Install]
WantedBy=multi-user.target
