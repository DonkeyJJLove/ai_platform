[Unit]
Description=LION Scale64 repository-native declarative controller
After=network-online.target lion-effect-admission.socket lion-broker-update.socket
Wants=network-online.target
[Service]
Type=simple
User=sentinelx
Group=sentinelx
ExecStart=/usr/bin/python3 /usr/local/libexec/lion-scale64-controller.py
Restart=no
TimeoutStartSec=0
TimeoutStopSec=120
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=128
MemoryMax=2G