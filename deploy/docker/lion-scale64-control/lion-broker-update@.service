[Unit]
Description=LION bounded broker update admission connection

[Service]
Type=simple

User=root
Group=root

ExecStart=/usr/bin/python3 /usr/local/libexec/lion-broker-update-provider.py

StandardInput=socket
StandardOutput=socket
StandardError=journal

UMask=0077

NoNewPrivileges=yes

PrivateTmp=yes
PrivateDevices=yes

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes

LockPersonality=yes
RestrictRealtime=yes

RestrictAddressFamilies=AF_UNIX

TasksMax=32
MemoryMax=256M

TimeoutStartSec=0
TimeoutStopSec=30