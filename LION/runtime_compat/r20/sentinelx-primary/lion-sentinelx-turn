#!/usr/bin/env python3
from __future__ import annotations
import json, re, sys, urllib.request, urllib.error
from pathlib import Path

INGRESS = "http://127.0.0.1:8791"
TOKEN_FILE = Path("/etc/lion/mcp-local-token")
TURN_RE = re.compile(r"^turn_[A-Za-z0-9-]{8,128}$")
ACTOR = "chatgpt-saas-sentinelx"

def fail(msg: str, code: int = 2):
    print(json.dumps({"ok": False, "error": msg}, separators=(",", ":")))
    raise SystemExit(code)

def token() -> str:
    try:
        value = TOKEN_FILE.read_text(encoding="utf-8").strip()
    except OSError:
        fail("ingress_credential_unavailable")
    if len(value) < 32:
        fail("ingress_credential_invalid")
    return value

def request(path: str, method: str = "GET", body=None):
    headers = {"Accept":"application/json","X-LION-Token":token(),"User-Agent":"LION-SentinelX-Bridge/1"}
    data = None
    if body is not None:
        data = json.dumps(body, ensure_ascii=False, separators=(",",":")).encode("utf-8")
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(INGRESS + path, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=10) as r:
            raw = r.read().decode("utf-8")
            return json.loads(raw) if raw else {}
    except urllib.error.HTTPError as e:
        raw = e.read().decode("utf-8","replace")
        fail("ingress_http_%s:%s" % (e.code, raw[:300]))
    except Exception as e:
        fail("ingress_unavailable:%s" % type(e).__name__)

def validate_turn_id(value: str) -> str:
    if not TURN_RE.fullmatch(value or ""):
        fail("invalid_turn_id")
    return value

def cmd_get(turn_id: str):
    turn = (request("/v1/turns/" + validate_turn_id(turn_id)).get("turn") or {})
    out = {
        "ok": True,
        "schema": "lion.sentinelx-turn.get/v1",
        "turn_id": turn.get("turn_id"),
        "status": turn.get("status"),
        "command_id": turn.get("command_id"),
        "thread_id": turn.get("thread_id"),
        "parent_event_id": turn.get("parent_event_id"),
        "request_hash": turn.get("request_hash"),
        "input": turn.get("input"),
        "metadata": turn.get("metadata") or {},
    }
    print(json.dumps(out, ensure_ascii=False, separators=(",",":")))

def cmd_complete(turn_id: str, actor: str, response_json: str):
    turn_id = validate_turn_id(turn_id)
    if actor != ACTOR:
        fail("invalid_actor")
    try:
        response = json.loads(response_json)
    except Exception:
        fail("invalid_response_json")
    if type(response) is not dict or set(response) != {"text"}:
        fail("response_schema")
    text = response.get("text")
    if not isinstance(text, str) or not text.strip() or len(text) > 24000:
        fail("response_text")
    result = request(
        "/v1/turns/" + turn_id + "/complete",
        "POST",
        {"response":{"text":text.strip()},"actor":actor},
    )
    turn = result.get("turn") or {}
    print(json.dumps({
        "ok": True,
        "schema": "lion.sentinelx-turn.complete/v1",
        "turn_id": turn.get("turn_id") or turn_id,
        "status": turn.get("status"),
        "completed_by": turn.get("completed_by"),
        "completed_at": turn.get("completed_at"),
    }, separators=(",",":")))

def main():
    if len(sys.argv) < 3:
        fail("usage:get <turn_id> | complete <turn_id> chatgpt-saas-sentinelx '<json>'")
    op = sys.argv[1]
    if op == "get" and len(sys.argv) == 3:
        cmd_get(sys.argv[2]); return
    if op == "complete" and len(sys.argv) == 5:
        cmd_complete(sys.argv[2], sys.argv[3], sys.argv[4]); return
    fail("invalid_command")

if __name__ == "__main__":
    main()
