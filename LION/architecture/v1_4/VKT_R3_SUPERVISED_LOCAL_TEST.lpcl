RUN=
LION-LPCL-1_0-VKT-R3-SUPERVISED-LOCAL-384-DRONE-TEST-v2

PROJECT=
LION_EVOLUSION

METAARCHITECTURE=
THE_BEAN_FACTORY

ARCHITECTURE_EPOCH=
1.4

PROCESS_LANGUAGE=
LPCL-1_0

HOST=
LION-AUTH-LAB

EXECUTION_CLASS=
LOCAL_SUPERVISED_RUNTIME_TEST

TRUST_CLASS=
TEST_ONLY

SOURCE_BRANCH=
master

SOURCE_IDENTITY_FILE=
/opt/lion/k3s-vkt-r3/source-identity.json

SOURCE_HEAD=
FROM_SOURCE_IDENTITY

SOURCE_TREE=
FROM_SOURCE_IDENTITY

LOCAL_ENVIRONMENT_PREPARATION=
ALLOWED

LOCAL_OBSERVATION=
ALLOWED

LOCAL_MANUAL_TEST_START=
DENY

TEST_EXECUTION_AUTHORITY=
LPCL_ONLY

TEST_MUTATION_AUTHORITY=
LPCL_ONLY

MISSION_CONTROL_AUTHORITY=
READ_ONLY

MISSION_CONTROL_ENDPOINT_SOURCE=
/var/lib/sentinelx/uploads/vkt-r3-mission-control/listen.json

PHASES=
REACQUIRE
PRECHECK
PREPARE
MATERIALIZE
SUBSTRATE_CONVERGENCE
MISSION_CONTROL_VERIFY
SEMANTIC_PREFLIGHT
FINAL_FREEZE
TEST_600_SECONDS
FINAL_VALIDATION
EVIDENCE_EXPORT
CLEANUP
CLEANUP_CONFIRM

TEST_600_SECONDS_REQUIRE=
UID_SET_UNCHANGED
READY_384
UNIQUE_UID_384
RESTARTS_0
FRESH_HEARTBEATS_384
CASES_PROVEN_36
MESSAGES_768
ACK_RATE_1_0
DUPLICATES_0
ORPHANS_0
VENDOR_REQUESTS_0

INTERVENTION_DURING_TEST=
DENY

FINAL_PASS_REQUIRES=
ALL_GATES_PASS
600_SECOND_VALIDATION_PASS
CLEANUP_PASS
VENDOR_REQUESTS_ZERO

NO_FALSE_COMPLETION=
TRUE
