RUN=LION-COOPERATIVE-PRODUCTION-PILOT-R3
PROJECT=LION_EVOLUSION
MODE=AUTONOMOUS_EXECUTE
CONTROL_LANGUAGE=LPCL/1.2
MISSION_ID=LION-COOPERATIVE-PRODUCTION-PILOT-R3
MISSION_TITLE=Cooperative production pilot R3 on MOON lion-r24-autonomy
MISSION_OBJECTIVE=Prove the live autonomous SaaS to logical drone to MD029 to LOCAL model path, bounded artifact production, and independent MD030 verification on the existing 32-worker lion-r24-autonomy fleet.
MISSION_DESCRIPTION=Successor to failed R1 and stale R2. R3 uses the explicit Docker-local-model runtime selector and the exact R6.17 cooperative provider source. MD029 is the builder canary and MD030 is the independent verifier. Preserve assignment, binding, generation, ModelCall, artifact bytes and receipt lineage. No merge, credential export, host-wide write, Docker prune/reset, second scheduler, fleet-wide rematerialization, or authority derived from model/provider output.
LOGICAL_DRONE_COUNT=2
MATERIAL_DRONE_COUNT=32
MATERIAL_RUNTIME=DOCKER_LOCAL_MODEL
LOGICAL_ROLE_PREFIX=COOP_PILOT_R3
PROTOCOLS=LPCL,ASSIGNMENT,HEARTBEAT,EVIDENCE,VALIDATION,RECEIPT,RECOVERY,CONTROL,LINEAGE,TRANSPORT
PILOT_TARGET_COMPOSE=/srv/lion-e4-candidate-r1/r20-mission/r24-autonomy/compose.yaml
PILOT_LOCAL_MODEL=http://host.docker.internal:8772
PILOT_MISSION_CONTROL=http://host.docker.internal:8766
PILOT_QUALIFICATION_WORKER=MD029
PILOT_BUILDER_WORKER=MD029
PILOT_VERIFIER_WORKER=MD030
PILOT_ARTIFACT_NAME=lion-pilot-artifact-r3.txt
PILOT_MAX_ARTIFACT_BYTES=4096
PILOT_PROVIDER_SOURCE_BRANCH=mission/cooperative-production-r1
PILOT_PROVIDER_SOURCE_HEAD=3f56b910c15b7f8ddaeea10b831999a50745dac8
PILOT_PROVIDER_SOURCE_TREE=608a134878c739f55a5af1c0ee72ed90c8ce2052
PREDECESSOR_FAILED_MISSION=LION-COOPERATIVE-PRODUCTION-PILOT-R1
PREDECESSOR_FAILED_DIGEST=abe2b631cf2d28e72772c40e9828b58dadcb8520ccdc03c2a74fd20b72f010bf
PREDECESSOR_DRAFT=LION-COOPERATIVE-PRODUCTION-PILOT-R2
FORCE_PUSH=DENY
DOCKER_PRUNE=DENY
DOCKER_RESET=DENY
SECRET_EXPORT=DENY
SECOND_SCHEDULER=DENY
FLEET_WIDE_REMATERIALIZATION=DENY
PHASE_01=QUALIFY_PROVIDER|Qualify R6.17 provider projection on MD029 without effect
PHASE_01_EXECUTION_CLASS=VERIFY
PHASE_01_CAPABILITY_CLASS=COOPERATIVE_ARTIFACT_BOOTSTRAP
PHASE_01_EFFECT_CEILING=NONE
PHASE_01_BINDING_MODE=DYNAMIC
PHASE_01_ON_MISSING_CAPABILITY=WAIT_AND_DISCOVER
PHASE_01_AUTO_RESUME=TRUE
PHASE_01_VERIFY_BEFORE_MUTATE=TRUE
PHASE_01_CURRENTNESS=LIVE_DOCKER_FLEET,LIVE_8766_PACKAGE,LIVE_LOCAL_MODEL,CURRENT_PROVIDER_SOURCE
PHASE_01_EVIDENCE=SOURCE_READBACK,WORKER_IDENTITY,PROVIDER_EVIDENCE_DB,CONTEXT_PIN,QUALIFICATION_RECEIPT
PHASE_01_COMPLETION_01=COOPERATIVE_PROVIDER_BOUND=PASS
PHASE_02=LOCAL_MODEL_BUILD|Generate bounded artifact candidate through LOCAL model and MD029
PHASE_02_EXECUTION_CLASS=COGNITIVE
PHASE_02_CAPABILITY_CLASS=COOPERATIVE_ARTIFACT_PRODUCTION
PHASE_02_EFFECT_CEILING=BOUNDED_MATERIAL
PHASE_02_BINDING_MODE=DYNAMIC
PHASE_02_ON_MISSING_CAPABILITY=WAIT_AND_DISCOVER
PHASE_02_AUTO_RESUME=TRUE
PHASE_02_VERIFY_BEFORE_MUTATE=TRUE
PHASE_02_CURRENTNESS=LIVE_DOCKER_FLEET,LIVE_LOCAL_MODEL,CURRENT_ASSIGNMENT_LEASE,CURRENT_PROVIDER_SOURCE
PHASE_02_EVIDENCE=MODEL_CALL_RECEIPT,ASSIGNMENT_RECEIPT,ARTIFACT_DIGEST,ARTIFACT_READBACK
PHASE_02_COMPLETION_01=ARTIFACT_CREATED=PASS
PHASE_03=INDEPENDENT_VERIFY|Verify exact artifact bytes using MD030
PHASE_03_EXECUTION_CLASS=VERIFY
PHASE_03_CAPABILITY_CLASS=COOPERATIVE_ARTIFACT_VERIFY
PHASE_03_EFFECT_CEILING=NONE
PHASE_03_BINDING_MODE=DYNAMIC
PHASE_03_ON_MISSING_CAPABILITY=WAIT_AND_DISCOVER
PHASE_03_AUTO_RESUME=TRUE
PHASE_03_VERIFY_BEFORE_MUTATE=TRUE
PHASE_03_CURRENTNESS=CURRENT_ASSIGNMENT_LEASE,CURRENT_ARTIFACT_GENERATION,CURRENT_PROVIDER_SOURCE
PHASE_03_EVIDENCE=ARTIFACT_READBACK,VERIFIER_RECEIPT,DIGEST_MATCH
PHASE_03_COMPLETION_01=ARTIFACT_VERIFIED=PASS
TERMINATION=COMPLETE_ON_VERIFIED_ARTIFACT
