{
  "schema": "lion.project-reality-evolution-path/v1",
  "path_id": "LION_PROJECT_REALITY_EVOLUTION_PATH_R1",
  "lifecycle": "CANDIDATE",
  "currentness": "SOURCE_BOUND_TO_PARENT_CANDIDATE",
  "purpose": "Compose project reality, epistemic claims, semantic relevance, deterministic evolution selection, formalization, mission execution and knowledge homeostasis into one path without creating a second truth store, scheduler, graph authority or runtime owner.",
  "architectural_decisions": [
    {
      "id": "PR-01",
      "decision": "ProjectRealitySnapshot is a digest-bound projection over existing WorldSnapshot, SystemSnapshot, federation/currentness evidence and EnterpriseGraph; it is not a new canonical database.",
      "disposition": "EXTEND_EXISTING_ARCHITECTURE_PROJECTION"
    },
    {
      "id": "PR-02",
      "decision": "Mental Matrix ClaimGraph maps to existing SemanticAtom/EvidenceInstance plus EnterpriseGraph DATA_PROVENANCE relations; no second claim graph store is introduced.",
      "disposition": "REUSE_EXISTING_GRAPH"
    },
    {
      "id": "PR-03",
      "decision": "Mental Matrix narrative, visual continuity and publication packages are downstream read-only projections of verified project reality. Narrative never upgrades epistemic class.",
      "disposition": "TARGET_CONSUMER"
    },
    {
      "id": "PR-04",
      "decision": "Dynamic Evolution Fitness consumes candidate-specific reality gates and evidence-bound pressure before ArchitectureCompiler. Fitness does not grant authority or schedule execution.",
      "disposition": "CANDIDATE_IMPLEMENTED_SOURCE"
    },
    {
      "id": "PR-05",
      "decision": "Architecture Studio and Mental Matrix consume the same project-reality/lineage substrate with different projections; neither owns execution.",
      "disposition": "SHARED_READ_MODEL"
    }
  ],
  "stages": [
