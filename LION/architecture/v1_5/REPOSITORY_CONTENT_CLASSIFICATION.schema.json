{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lion.repository-content-classification/v1",
  "title": "LION repository content classification",
  "type": "object",
  "required": [
    "schema",
    "generated_from",
    "repositories",
    "files",
    "coverage_groups"
  ],
  "properties": {
    "schema": {
      "const": "lion.repository-content-census/v1"
    },
    "generated_from": {
      "type": "object"
    },
    "repositories": {
      "type": "array"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository",
          "path",
          "classification",
          "classification_basis",
          "size_bytes",
          "sha256"
        ],
        "properties": {
          "repository": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "classification": {
            "enum": [
              "CURRENT_SOURCE",
              "CURRENT_CONTRACT",
              "CURRENT_CONFIG",
              "CURRENT_TEST",
              "CURRENT_DOCUMENTATION",
              "CURRENT_GENERATED",
              "CURRENT_RUNTIME",
              "CURRENT_UI",
              "CURRENT_TOOL",
              "VERSIONED_STATIC",
              "COMPATIBILITY_LAYER",
              "HISTORICAL",
              "HISTORICAL_EVIDENCE",
              "ARCHIVED",
              "GENERATED_BUT_STALE",
              "SOURCE_BUT_UNREFERENCED",
              "DOCUMENTED_BUT_UNIMPLEMENTED",
              "IMPLEMENTED_BUT_UNDOCUMENTED",
              "DUPLICATE_SEMANTICS",
              "DUPLICATE_IMPLEMENTATION",
              "DUPLICATE_DOCUMENTATION",
              "DEPRECATED",
              "DELETE_CANDIDATE",
              "UNKNOWN"
            ]
          },
          "classification_basis": {
            "type": "string"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "oneOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "const": "SELF_REFERENTIAL"
              }
            ]
          },
          "naming_conformance": {
            "type": "string"
          },
          "flags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "coverage_groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "repository",
          "path_prefix",
          "classification",
          "classification_basis",
          "generated_output_class",
          "file_count",
          "total_bytes",
          "git_tree_sha",
          "extension_counts",
          "coverage_semantics"
        ],
        "properties": {
          "repository": {
            "type": "string"
          },
          "path_prefix": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "enum": [
              "CURRENT_SOURCE",
              "CURRENT_CONTRACT",
              "CURRENT_CONFIG",
              "CURRENT_TEST",
              "CURRENT_DOCUMENTATION",
              "CURRENT_GENERATED",
              "CURRENT_RUNTIME",
              "CURRENT_UI",
              "CURRENT_TOOL",
              "VERSIONED_STATIC",
              "COMPATIBILITY_LAYER",
              "HISTORICAL",
              "HISTORICAL_EVIDENCE",
              "ARCHIVED",
              "GENERATED_BUT_STALE",
              "SOURCE_BUT_UNREFERENCED",
              "DOCUMENTED_BUT_UNIMPLEMENTED",
              "IMPLEMENTED_BUT_UNDOCUMENTED",
              "DUPLICATE_SEMANTICS",
              "DUPLICATE_IMPLEMENTATION",
              "DUPLICATE_DOCUMENTATION",
              "DEPRECATED",
              "DELETE_CANDIDATE",
              "UNKNOWN"
            ]
          },
          "classification_basis": {
            "type": "string"
          },
          "generated_output_class": {
            "enum": [
              "SOURCE_DATA",
              "GOLDEN_FIXTURE",
              "CANONICAL_RESULT",
              "REPRODUCIBLE_OUTPUT",
              "PUBLICATION_ARTIFACT",
              "ARCHIVED_RUN"
            ]
          },
          "file_count": {
            "type": "integer",
            "minimum": 1
          },
          "total_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "git_tree_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "extension_counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "coverage_semantics": {
            "const": "ALL_TRACKED_FILES_UNDER_PREFIX_AT_BOUND_HEAD"
          }
        }
      }
    }
  }
}
