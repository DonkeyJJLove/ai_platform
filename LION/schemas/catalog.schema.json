{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"lion.catalog.schema.json","title":"LION Operational Catalog","type":"object","additionalProperties":false,"required":["schema_version","catalog_id","repository","baseline","planes","entrypoint","architecture","operations","protocols","authoritative_sources","precedence","rules"],"properties":{"schema_version":{"const":"1.0.0"},"catalog_id":{"const":"lion-ops-catalog"},"repository":{"type":"string","minLength":1},"baseline":{"type":"object","required":["commit","tree"],"properties":{"commit":{"type":"string","pattern":"^[0-9a-f]{40}$"},"tree":{"type":"string","pattern":"^[0-9a-f]{40}$"}},"additionalProperties":false},"planes":{"type":"array","const":["NORMATIVE","OBSERVED","OPERATIONAL"]},"entrypoint":{"type":"string"},"architecture":{"type":"object"},"operations":{"type":"object"},"protocols":{"type":"object"},"authoritative_sources":{"type":"object"},"precedence":{"type":"array","minItems":1,"items":{"type":"string"}},"rules":{"type":"object","required":["chat_history_canonical","registry_state_is_authority","runtime_effect","authority_mint","live_resnapshot_before_consequential_use"],"properties":{"chat_history_canonical":{"const":false},"registry_state_is_authority":{"const":false},"runtime_effect":{"const":false},"authority_mint":{"const":false},"live_resnapshot_before_consequential_use":{"const":true}},"additionalProperties":false}}}